rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules for classes collection and subcollections
    match /classes/{classId} {
      // Siswa and bendahara can read class overview
      allow read: if true;
      // Only backend admin SDK or authorized service accounts can write directly
      allow write: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if true;
        // Writes strictly handled through Cloud Functions / Telegram Bot Webhook
        allow write: if false;
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if true;
        allow write: if false;
      }

      // Reports snapshot subcollection
      match /reports/{reportId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
